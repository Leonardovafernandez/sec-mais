# =============================================================
# SEC MAIS - Configurações de Ambiente
# ATENÇÃO: Copie este arquivo como .env e preencha os valores
#          NUNCA commite o arquivo .env no repositório
# =============================================================

# --- Oracle (fonte de dados) ---
# IMPORTANTE: Requer VPN ativa para conexão
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SCHEMA=

# --- PostgreSQL (fonte de dados) ---
# IMPORTANTE: Requer VPN ativa para conexão
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=

# --- Configurações Gerais ---
AMBIENTE=desenvolvimento
LOG_LEVEL=INFO

# --- Caminhos de Armazenamento ---
# Deixe vazio para usar o padrão relativo ao projeto
STORAGE_BASE_PATH=

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///airflow/airflow.db

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_APP_NAME=sec_mais
